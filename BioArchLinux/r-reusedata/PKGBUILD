_pkgname=ReUseData
_pkgver=1.12.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Reusable and reproducible Data Management"
arch=(any)
url="https://bioconductor.org/packages/$_pkgname"
license=('GPL-3.0-only')
depends=(
  r-basilisk
  r-biocfilecache
  r-jsonlite
  r-rcwl
  r-rcwlpipelines
  r-s4vectors
  r-yaml
)
optdepends=(
  r-biocstyle
  r-knitr
  r-rmarkdown
  r-testthat
)
source=("https://bioconductor.org/packages/release/bioc/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('a293d5c452202bdbaa6953d12f1eec62')
b2sums=('b769a264925a512af060a7a78880aff97a55f356d5c9dddfbe0e2c720e0ee06058f33daff2ee1c29c786af6b6cc91888d27ac1807dce924f57c2de97c0c3d0a4')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
