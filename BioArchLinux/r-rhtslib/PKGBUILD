_pkgname=Rhtslib
_pkgver=3.10.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="HTSlib high-throughput sequencing library as an R package"
arch=(x86_64)
url="https://bioconductor.org/packages/$_pkgname"
license=('LGPL-2.0-or-later')
depends=(
  bzip2
  curl
  r
  xz
  zlib
)
optdepends=(
  r-biocstyle
  r-knitr
  r-rmarkdown
)
options=(staticlibs)
source=("https://bioconductor.org/packages/release/bioc/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('4215fdd93745ca497159712b87ac8d17')
b2sums=('96d51d8cd79d381a8cc12f752e38e6c07827516cbdcf60b3790db4ddf6120df5a4b6bd4836baf1868dd53d023021739b4481c529c132c2f436400ef63c89356b')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
