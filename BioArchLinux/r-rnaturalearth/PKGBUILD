# Maintainer: Guoyi <kuoi@bioarchlinux.org>

_pkgname=rnaturalearth
_pkgver=1.2.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//[:-]/.}
pkgrel=1
pkgdesc="World Map Data from Natural Earth"
arch=(any)
url="https://cran.r-project.org/package=${_pkgname}"
license=('MIT')
depends=(
  r-cli
  r-httr
  r-jsonlite
  r-sf
  r-terra
)
optdepends=(
  r-dplyr
  r-ggplot2
  r-ggrepel
  r-knitr
  r-lifecycle
  r-pak
  r-pbapply
  r-purrr
  r-rlang
  r-rmarkdown
  r-rnaturalearthdata
  r-rnaturalearthhires
  r-testthat
  r-tmap
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('fe9320899712bcbe9b05f0f7d3a7d391')
b2sums=('068465692661e150cd4b6f03272eb2f8639a83dfbaba7d9c076648bbb3ca5df61f6a333b0a22e0b7e8decc00ab9fd49cf9a80978a1807ff79b00030dc666480e')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
