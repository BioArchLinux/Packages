_pkgname=BGGM
_pkgver=2.2.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Bayesian Gaussian Graphical Models"
arch=('x86_64')
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-only')
depends=(
  r-bfpack
  r-ggally
  r-ggplot2
  r-ggridges
  r-mvnfast
  r-network
  r-rcpp
  r-rdpack
  r-reshape
  r-rlang
  r-sna
  r-truncnorm
)
makedepends=(
  r-rcpparmadillo
  r-rcppdist
  r-rcppprogress
)
optdepends=(
  r-abind
  r-assortnet
  r-knitr
  r-mice
  r-networktools
  r-psych
  r-rmarkdown
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('008af197fd85f1d02e1ab0139466e596')
b2sums=('c898c63b7db66174f7b6f9a565744f8d0a9bbee92f53d83f6fcc6c03e98e20cd791dd6103d3873245131941f0f6ed99536a6af4008db0e6f405d38fd03cb4595')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
