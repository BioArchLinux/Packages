# Maintainer: Boris Shor <boris@bshor.com>

_pkgname=leaflegend
_pkgver=1.3.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Add Custom Legends to 'leaflet' Maps"
arch=(any)
url="https://leaflegend.delveds.com"
license=('MIT')
depends=(
  r-base64enc
  r-htmltools
  r-htmlwidgets
  r-leaflet
)
optdepends=(
  r-covr
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('54ec302004a7659d60158988cdd6533d')
b2sums=('87a0e02d7ff005a37f8dcc01748a235829e4af9df94df68543e6b2d8c1064320e84d4d9cc1e9c0fea10f8ff01ad5f565faf290e1447e9b0deef576e488b2165c')

build() {
  R CMD INSTALL ${_pkgname}_${_pkgver}.tar.gz -l "${srcdir}"
}

package() {
  install -dm0755 "${pkgdir}/usr/lib/R/library"
  cp -a --no-preserve=ownership "${_pkgname}" "${pkgdir}/usr/lib/R/library"
  install -Dm644 "${_pkgname}/LICENSE" -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
