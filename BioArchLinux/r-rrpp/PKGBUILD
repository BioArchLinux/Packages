# Maintainer: Guoyi <kuoi@malacology.net>

_pkgname=RRPP
_pkgver=2.2.6
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc='Linear Model Evaluation with Randomized Residuals in a Permutation Procedure'
arch=('any')
url="https://cran.r-project.org/package=${_pkgname}"
license=('GPL-3.0-or-later')
depends=(
  r-ape
  r-ggplot2
  r-lme4
)
optdepends=(
  r-dplyr
  r-knitr
  r-rmarkdown
  r-testthat
  r-tibble
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('139b9e12e7bc489331a1ef472b51284d')
b2sums=('2c420dcf1f1275286c497a7fcc63bf421dcc2b0ffba58b8b7b28310b63f7bfb1ec74ad04eaf3993e9d34e4c1f3d95b575c8256940021ad3ee525ef43f986e936')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
