# Maintainer: Guoyi <kuoi@malacology.net>

_pkgname=RRPP
_pkgver=2.2.5
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc='Linear Model Evaluation with Randomized Residuals in a Permutation Procedure'
arch=('any')
url="https://cran.r-project.org/package=${_pkgname}"
license=('GPL-3.0-or-later')
depends=(
  r-ape
  r-ggplot2
  r-lme4
)
optdepends=(
  r-dplyr
  r-knitr
  r-rmarkdown
  r-testthat
  r-tibble
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('e1d5d6356d0a592787002a23a15163c7')
b2sums=('ab4d0c4220379165348a0c56fd446257a2d2c66c2f7190b9e5c69adff42de72861f826f0f07568f79a5e51af35484974a0b1d4a88cf99d4bd800aec53d0ec7c5')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
