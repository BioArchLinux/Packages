# Maintainer: Adityarup Laha <me@adityaruplaha.me>

_pkgname=bsicons
_pkgver=0.1.2
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Easily Work with 'Bootstrap' Icons"
arch=(any)
url="https://cran.r-project.org/package=$_pkgname"
license=('MIT')
depends=(
  r-cli
  r-htmltools
  r-rlang
)
optdepends=(
  r-bslib
  r-processx
  r-testthat
  r-webshot2
  r-withr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('bc01c2d201744fe791e7d2e9cd7434f2')
b2sums=('62d5b626d3a5056e46e372c8b65900b74651a6ccdb4e0d2dbca3ec984e146319a56bf06a4049133a6e84e61c8e1b20de2d85e9bde84ae6b2b4e59fae94d2076f')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"

  install -d "$pkgdir/usr/share/licenses/$pkgname"
  ln -s "/usr/lib/R/library/$_pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname"
}
