_pkgname=see
_pkgver=0.15.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Model Visualisation Toolbox for 'easystats' and 'ggplot2'"
arch=(any)
url="https://easystats.github.io/see/"
license=('MIT')
depends=(
  r-bayestestr
  r-correlation
  r-datawizard
  r-effectsize
  r-ggplot2
  r-insight
  r-modelbased
  r-parameters
  r-patchwork
  r-performance
)
optdepends=(
  r-bh
  r-brms
  r-collapse
  r-curl
  r-dharma
  r-discovr
  r-emmeans
  r-factoextra
  r-formula
  r-ggdag
  r-ggdist
  r-ggraph
  r-ggrepel
  r-ggridges
  r-ggside
  r-glmmtmb
  r-httr2
  r-lavaan
  r-lme4
  r-logspline
  r-marginaleffects
  r-mclogit
  r-mclust
  r-merderiv
  r-metafor
  r-nbclust
  r-nfactors
  r-psych
  r-qqplotr
  r-randomforest
  r-rcppeigen
  r-rlang
  r-rmarkdown
  r-rstanarm
  r-scales
  r-testthat
  r-tidygraph
  r-vdiffr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('f7b9ee1ddf9ade0b445eae348e762c0a')
b2sums=('f61f8365e7f54e36a0bba21df1924fa031a85b68b9b4b78da44a7199fbbf3653725e336c9f883649babde6adcd6ab4ab2994ed61418703b74b995d71f2e57cbe')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"

  install -d "$pkgdir/usr/share/licenses/$pkgname"
  ln -s "/usr/lib/R/library/$_pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname"
}
