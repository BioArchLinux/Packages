# Maintainer: Guoyi <kuoi@bioarchlinux.org>

_pkgname=graph4lg
_pkgver=2.0.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//[:-]/.}
pkgrel=1
pkgdesc="Build Graphs for Landscape Genetics Analysis"
arch=('any')
url="https://cran.r-project.org/package=${_pkgname}"
license=('GPL-2.0-only')
depends=(
  r-adegenet
  r-ecodist
  r-gdistance
  r-ggplot2
  r-hierfstat
  r-igraph
  r-pegas
  r-rappdirs
  r-raster
  r-rdpack
  r-sf
  r-spatstat.geom
  r-spatstat.linnet
  r-stringr
  r-terra
  r-tidyr
  r-vegan
)
optdepends=(
  r-knitr
  r-rmarkdown
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('9568e9ed3b1508534d80aef50a18d607')
b2sums=('797e04d17c0cbca84c696b1914d0725642e32443a233b06613ea4e944d30004c909eba1e3194bd7e313ee73985176f16352e46c1080a90aad59c39ff9ec8a6c4')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
