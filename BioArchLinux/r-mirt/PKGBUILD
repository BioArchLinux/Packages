_pkgname=mirt
_pkgver=1.47
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Multidimensional Item Response Theory"
arch=('x86_64')
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-3.0-or-later')
depends=(
  r-gparotation
  r-gridextra
  r-rcpp
  r-vegan
  r-deriv
  r-pbapply
  r-dcurver
  r-simdesign
  r-splines2
)
makedepends=(
  r-rcpparmadillo
)
optdepends=(
  r-latticeextra
  r-directlabels
  r-shiny
  r-knitr
  r-markdown
  r-rsolnp
  r-nloptr
  r-sirt
  r-plink
  r-mirai
  r-mirtcat
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('7bad5adb095d868cf5474736cf6d4531')
b2sums=('9a7fe0b51304036f24e945fa33661bc19b08fa78934a6f2bb4a7e910d52530831ff9e96bab1d21a52646364a86627cea5069d0bfeb47a55c1c9b8da1dbbc8189')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
