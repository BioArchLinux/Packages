_pkgname=mirt
_pkgver=1.48
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Multidimensional Item Response Theory"
arch=('x86_64')
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-3.0-or-later')
depends=(
  r-gparotation
  r-gridextra
  r-rcpp
  r-vegan
  r-deriv
  r-pbapply
  r-dcurver
  r-simdesign
  r-splines2
)
makedepends=(
  r-rcpparmadillo
)
optdepends=(
  r-latticeextra
  r-directlabels
  r-shiny
  r-knitr
  r-markdown
  r-rsolnp
  r-nloptr
  r-sirt
  r-plink
  r-mirai
  r-mirtcat
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('80c658db3289b735ef54f2a9d5c716ca')
b2sums=('7a43e563a7ed93fd399511e9f1c1ef5869f25474a70f3076f0eefd1f014def0887f990ab1008bfec628f86d690b0e6c2770f03e862803c6a87a3a8682d318832')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
