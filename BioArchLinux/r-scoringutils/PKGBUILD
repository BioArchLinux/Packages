_pkgname=scoringutils
_pkgver=2.3.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Utilities for Scoring and Assessing Predictions"
arch=('any')
url="https://cran.r-project.org/package=$_pkgname"
license=('MIT')
depends=(
  r-checkmate
  r-cli
  r-data.table
  r-ggplot2
  r-lifecycle
  r-purrr
  r-scoringrules
)
optdepends=(
  r-ggdist
  r-kableextra
  r-knitr
  r-metrics
  r-rmarkdown
  r-testthat
  r-vdiffr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('985224b63472df55a1d0da04a9378dc1')
b2sums=('defba37346da9c51b0e4447abc911b9cd6f4ba095f6a3c74258a5e8c518738ef7e14884681142e181dd2753f5b30d8f450bad7f3680c5a1a365f72f4d1ae355e')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
