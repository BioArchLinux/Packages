_pkgname=DelayedArray
_pkgver=0.40.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="A unified framework for working transparently with on-disk and in-memory array-like datasets"
arch=(any)
url="https://bioconductor.org/packages/$_pkgname"
license=('Artistic-2.0')
depends=(
  r-biocgenerics
  r-iranges
  r-matrixgenerics
  r-s4arrays
  r-s4vectors
  r-sparsearray
)
optdepends=(
  r-airway
  r-biocparallel
  r-biocstyle
  r-delayedmatrixstats
  r-genefilter
  r-hdf5array
  r-knitr
  r-lobstr
  r-rmarkdown
  r-runit
  r-summarizedexperiment
  r-zarrarray
)
source=("https://bioconductor.org/packages/release/bioc/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('2013a4d3b51c5c5d42e7c34fccc798d0')
b2sums=('f15dacdbea464595e84738d92a09e1909b5018e376ba823564961cc3b6425785b874ea6e5422886e156d05d4dab0d6036542f338cb26bb4dd28657e6d73038cc')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
