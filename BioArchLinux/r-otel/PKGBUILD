# Maintainer: Guoyi <kuoi@bioarchlinux.org>

_pkgname=otel
_pkgver=0.3.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//[:-]/.}
pkgrel=1
pkgdesc="OpenTelemetry R API"
arch=(any)
url="https://cran.r-project.org/package=${_pkgname}"
license=('MIT')
depends=(
  r
)
optdepends=(
  r-callr
  r-cli
  r-glue
  r-jsonlite
  r-otelsdk
  r-processx
  r-shiny
  r-spelling
  r-testthat
  r-withr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('b9c41923305ec69ba71e80b63e86ec02')
b2sums=('2aa036f9808c21dfc0f722a00fccb35088c4b2473960c74c2173dd4ea02074e32bad2b25fb4ef7f7b6e662e68a5a07359c0969c37112e93eeea964749609b428')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
