# Maintainer: shun2wang <shuonwang@gmail.com>

_pkgname=metaSEM
_pkgver=2.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Meta-Analysis using Structural Equation Modeling"
arch=(any)
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-or-later')
depends=(
  r-ellipse
  r-lavaan
  r-mvtnorm
  r-numderiv
  r-openmx
)
optdepends=(
  r-matrixcalc
  r-metafor
  r-r.rsp
  r-sandwich
  r-semplot
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('605bae9e460d82ce2530f2384a127d03')
b2sums=('cbb79ef68dabf001ed9d935afc095a108b8607e1f62c9a806b01d06546abb1e1e1b7c8c7f32f6347140d7d67afcb76ef9fb15071bf01bb269abecb621e738661')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
