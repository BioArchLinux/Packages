_pkgname=mantar
_pkgver=0.3.2
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Missingness Alleviation for Network Analysis"
arch=(any)
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-3.0-or-later')
depends=(
  r-rdpack
  r-mathjaxr
  r-glassofast
)
optdepends=(
  r-numderiv
  r-mice
  r-lavaan
  r-qgraph
  r-testthat
  r-knitr
  r-rmarkdown
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('8440619ec32a8ec9fc7b093b2415438a')
b2sums=('80b5033543534ea6f1c3846f7885f079333f500f9f0489eac7b3fd92e1e2a26268a09381dbd1469570f6644ae6a60334eeb28b9b7ddf66ee8dafaeb0df06a3c6')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
