_pkgname=stringi
_pkgver=1.8.9
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Fast and Portable Character String Processing Facilities"
arch=(x86_64)
url="https://cran.r-project.org/package=$_pkgname"
license=('BSD-3-Clause AND GPL-2.0-or-later')
depends=(
  icu
  r
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('6888a5ac007ad34590ce6afbd0cb2491')
b2sums=('845ab6018ee87203304a04864fad54ff42998b228750c2483bbbeff7ae65beed0fd200f3c49c42bbcb135db0b229744602169db4aa318b89dcf7332f2f4122b6')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname" \
#      --configure-args=--disable-icu-bundle
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"

  install -d "$pkgdir/usr/share/licenses/$pkgname"
  ln -s "/usr/lib/R/library/$_pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname"
}
