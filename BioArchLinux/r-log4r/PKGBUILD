_pkgname=log4r
_pkgver=0.5.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="A Fast and Lightweight Logging System for R, Based on 'log4j'"
arch=(x86_64)
url="https://cran.r-project.org/package=$_pkgname"
license=('Artistic-2.0')
depends=(
  r-cli
  r-lifecycle
  r-rlang
)
optdepends=(
  r-futile.logger
  r-httr
  r-jsonlite
  r-knitr
  r-lgr
  r-logger
  r-logging
  r-microbenchmark
  r-rlog
  r-rmarkdown
  r-rsyslog
  r-testthat
  r-webfakes
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('9f9cab87435d4d91b456d9b4c9af5180')
b2sums=('de7d4ef1cb6a464cd5ab695b23fe8c85e6ee6a128e206639196f72c6e77e4e8f88180d8b16044c704f863b0c20f268d962f2e1966784fb5a13ca81b04c079bb1')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
