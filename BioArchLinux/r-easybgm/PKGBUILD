_pkgname=easybgm
_pkgver=0.5.1
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Extracting and Visualizing Bayesian Graphical Models"
arch=(any)
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-or-later')
depends=(
  r-bdgraph
  r-bggm
  r-bgms
  r-coda
  r-dplyr
  r-ggplot2
  r-hdinterval
  r-qgraph
)
optdepends=(
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('29c74a2e59942f0bdf20f4e1e7d773e0')
b2sums=('649f25371517a16dab31a1b73ac0d71ac16b8dbd9a6c83da6cdd5ffa6c860fd00e945f21761c18e654a5b6a6bc96a9e60b9e9beb9d0afa9fbcc29d3c5746074a')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
