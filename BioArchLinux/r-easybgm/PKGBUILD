# Maintainer: shun2wang <shuonwang@gmail.com>

_pkgname=easybgm
_pkgver=0.5.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=2
pkgdesc="Extracting and Visualizing Bayesian Graphical Models"
arch=(any)
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-or-later')
depends=(
  r-bdgraph
  r-bggm
  r-bgms
  r-coda
  r-dplyr
  r-ggplot2
  r-hdinterval
  r-qgraph
)
optdepends=(
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('6b954376f052b75b08740ca5f923465e')
b2sums=('010f909771a77ff4ed82c248a1b6fde9955f2294452312dd4627d86d11e5c9caf7252a8ac7f244823e3aef7d8fa67d60eb3883a1edfdb3a5832f8c3de5bad844')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
