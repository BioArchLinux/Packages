# Maintainer: Boris Shor <boris@bshor.com>

_pkgname=vitals
_pkgver=0.4.1
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Large Language Model Evaluation"
arch=(any)
url="https://vitals.tidyverse.org/"
license=('MIT')
depends=(
  r-cli
  r-dplyr
  r-ellmer
  r-glue
  r-httpuv
  r-jsonlite
  r-purrr
  r-r6
  r-rlang
  r-s7
  r-tibble
  r-tidyr
  r-withr
)
optdepends=(
  r-ggplot2
  r-here
  r-htmltools
  r-httr2
  r-knitr
  r-magick
  r-ordinal
  r-reticulate
  r-rmarkdown
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('715c05f8da2f60d60173a4f26218946e')
b2sums=('8c7674b42ece9862728007d193ef7ac1eed4b7db96dcc51128ab992a6b306bdf668065e0c02e155117b2d4aa0560b775d82b1ab3d6ec3ffc2299f37ddbd81c41')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"

  install -d "$pkgdir/usr/share/licenses/$pkgname"
  ln -s "/usr/lib/R/library/$_pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname"
}
