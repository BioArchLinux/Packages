# Maintainer: Guoyi <kuoi@bioarchlinux.org>

_pkgname=phylopath
_pkgver=1.4.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//[:-]/.}
pkgrel=1
pkgdesc='Perform Phylogenetic Path Analysis'
arch=('any')
url="https://cran.r-project.org/package=${_pkgname}"
license=('GPL-3.0-only')
depends=(
  r-ape
  r-future.apply
  r-ggm
  r-ggplot2
  r-ggraph
  r-igraph
  r-phylolm
  r-purrr
  r-rlang
  r-tibble
)
optdepends=(
  r-knitr
  r-rmarkdown
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('cab60976b2e06088b946fd20d975db67')
b2sums=('d569e6c6fcee3fbb137520961da956f348365fd1c9aa0d2618020cb7a4c00ffbc9b5aa96b5c245383d38a8010c208360522411e8d9877d72af3eaddd629d447c')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
