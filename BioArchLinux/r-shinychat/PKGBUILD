# Maintainer: Boris Shor <boris@bshor.com>

_pkgname=shinychat
_pkgver=0.5.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Chat UI Component for 'shiny'"
arch=(any)
url="https://github.com/posit-dev/shinychat"
license=('MIT')
depends=(
  r-base64enc
  r-bslib
  r-cli
  r-coro
  r-ellmer
  r-fastmap
  r-htmltools
  r-jsonlite
  r-lifecycle
  r-promises
  r-r6
  r-rlang
  r-s7
  r-shiny
)
optdepends=(
  r-chromote
  r-covr
  r-knitr
  r-later
  r-rmarkdown
  r-shinytest2
  r-testthat
  r-withr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('d7d1425f3a5fbaf457f196a82d694e57')
b2sums=('3e03c586efff45b797a1e0df6366374a89b73ddc7aa36f8528e982b4bcd60139669b500152915805a4bb98b2846ce78d01723f1e86ce2e5c1dfef3861a6df8ae')

build() {
  R CMD INSTALL ${_pkgname}_${_pkgver}.tar.gz -l "${srcdir}"
}

package() {
  install -dm0755 "${pkgdir}/usr/lib/R/library"
  cp -a --no-preserve=ownership "${_pkgname}" "${pkgdir}/usr/lib/R/library"
  install -Dm644 "${_pkgname}/LICENSE" -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
