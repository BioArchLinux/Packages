_pkgname=qs2
_pkgver=0.3.1
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Efficient Serialization of R Objects"
arch=('x86_64')
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-3.0-only')
depends=(
  r-rcpp
  r-rcppparallel
  r-stringfish
)
makedepends=(
)
optdepends=(
  r-data.table
  r-dplyr
  r-knitr
  r-rmarkdown
  r-stringi
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('f28443f5de1e6c84e121f10afa1c2aa9')
b2sums=('5e8c8f16b545efbff9a6ee07c122932e9c68d6aa397c828a9627f0bfa04c1a27ca8cb4dfe1f00d8663721b7d9f0c53c9032bffa3d6bb33713086c71d542107f3')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
