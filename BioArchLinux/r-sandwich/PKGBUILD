_pkgname=sandwich
_pkgver=3.1-3
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Robust Covariance Matrix Estimators"
arch=(any)
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-only OR GPL-3.0-only')
depends=(
  r-zoo
)
optdepends=(
  r-aer
  r-car
  r-geepack
  r-lme4
  r-lmtest
  r-multiwayvcov
  r-pcse
  r-plm
  r-pscl
  r-scatterplot3d
  r-strucchange
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('f66564422dfbed1b7fe2c38ac2e49dd8')
b2sums=('ab4a6b9ddde525cd6cd3b1fb26b200098e5d94e484bb6c07be753fc459847a63e56e142e441be59b8c1842ab7e56190e04251b0b76bbac364e8e0d546e182ff5')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
