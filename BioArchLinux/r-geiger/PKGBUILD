# Maintainer: Guoyi <kuoi@bioarchlinux.org>

_pkgname=geiger
_pkgver=2.0.12
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//[:-]/.}
pkgrel=1
pkgdesc='Analysis of Evolutionary Diversification'
arch=('x86_64')
url="https://cran.r-project.org/package=${_pkgname}"
license=('GPL-2.0-or-later')
depends=(
  r-ape
  r-coda
  r-colorspace
  r-desolve
  r-digest
  r-mvtnorm
  r-ncbit
  r-phytools
  r-rcpp
  r-subplex
)
optdepends=(
  r-treesim
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('93ee909862abb0a728b69bb06e82b23a')
b2sums=('728e86bfceeade9a59f979cb99240c789593f82fa4d34ee3b8b622f7b51c7db41340a29bd6940c47be2812a0291caf9ed0ac81c39a3d0a45661d2e265643f14b')

build() {
  R CMD INSTALL ${_pkgname}_${_pkgver}.tar.gz -l "${srcdir}"
}

package() {
  install -dm0755 "${pkgdir}/usr/lib/R/library"
  cp -a --no-preserve=ownership "${_pkgname}" "${pkgdir}/usr/lib/R/library"
}
