_pkgname=expm
_pkgver=1.0-1
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Matrix Exponential, Log, 'etc'"
arch=(x86_64)
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-or-later')
depends=(
  blas
  lapack
  r
)
makedepends=(
  gcc-fortran
)
optdepends=(
  r-rcolorbrewer
  r-rmpfr
  r-sfsmisc
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('730720e4a1b29b0ca504d98e434f7904')
b2sums=('04c308156827ff191d3537ddf0af417830719a529281b9e049bd6e2a4846ed91354f866fe7993c1d05ba81d18f8b146ed3b287eac2bcaa52edafa95721386bf0')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
