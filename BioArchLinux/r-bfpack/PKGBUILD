_pkgname=BFpack
_pkgver=1.6.1
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Flexible Bayes Factor Testing of Scientific Expectations"
arch=('x86_64')
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-3.0-or-later')
depends=(
  r-bain
  r-bergm
  r-berryfunctions
  r-coda
  r-ergm
  r-lme4
  r-metabma
  r-mvtnorm
  r-pracma
  r-qrm
  r-sandwich
)
makedepends=(
  gcc-fortran
)
optdepends=(
  r-knitr
  r-lmtest
  r-metafor
  r-polycor
  r-pscl
  r-remstimate
  r-rmarkdown
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('32d1b5dfa23c3b68e8d06ccfdc5f9dec')
b2sums=('d892fdc42d7c56c80be7055817743e354d825682acd831d791da2ba9df3e853d14176236e0168d20ae4283095715bac384df16fa0ef8205148b0baaffe349738')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
