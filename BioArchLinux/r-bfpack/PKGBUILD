_pkgname=BFpack
_pkgver=1.6.3
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Flexible Bayes Factor Testing of Scientific Expectations"
arch=('x86_64')
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-3.0-or-later')
depends=(
  r-bain
  r-bergm
  r-berryfunctions
  r-coda
  r-ergm
  r-lme4
  r-metabma
  r-mvtnorm
  r-pracma
  r-qrm
  r-sandwich
)
makedepends=(
  gcc-fortran
)
optdepends=(
  r-knitr
  r-lmtest
  r-metafor
  r-polycor
  r-pscl
  r-remstimate
  r-rmarkdown
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('2daf4d340700663a2baec583b4f5a211')
b2sums=('0cf8a7500334e3668e8ef154fa51b0000d66d32a6a5deef54e2b91ca6ba32ff03f274089061cc1650f5e094cf13aff1bdd7cf947e4e2fb2a3bdfc044380d2063')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
