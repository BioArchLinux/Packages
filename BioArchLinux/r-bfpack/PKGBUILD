_pkgname=BFpack
_pkgver=1.6.2
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Flexible Bayes Factor Testing of Scientific Expectations"
arch=('x86_64')
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-3.0-or-later')
depends=(
  r-bain
  r-bergm
  r-berryfunctions
  r-coda
  r-ergm
  r-lme4
  r-metabma
  r-mvtnorm
  r-pracma
  r-qrm
  r-sandwich
)
makedepends=(
  gcc-fortran
)
optdepends=(
  r-knitr
  r-lmtest
  r-metafor
  r-polycor
  r-pscl
  r-remstimate
  r-rmarkdown
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('c08079ac2974d0392976f8e59acd9981')
b2sums=('14287395a57c3d6d2e4134badb02f3d188fbe2af847d24421b6ab70156d261a1cb7e4090809fd56b0a8af1a824de06a8507a431d6dea050fcc91fc32a0d0b6e1')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
