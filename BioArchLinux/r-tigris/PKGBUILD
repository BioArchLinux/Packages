# Maintainer: Boris Shor <boris@bshor.com>

_pkgname=tigris
_pkgver=2.3.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Load Census TIGER/Line Shapefiles"
arch=(any)
url="https://github.com/walkerke/tigris"
license=('MIT')
depends=(
  r-cli
  r-dplyr
  r-httr2
  r-magrittr
  r-rappdirs
  r-rlang
  r-sf
  r-stringr
  r-zip
)
optdepends=(
  r-ggplot2
  r-knitr
  r-leaflet
  r-sp
  r-testthat
  r-withr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('fa208243acb8d7cc65dbf9a970906036')
b2sums=('034f44116b663704ee486dffec5af2c699840b712936dffeac0fc68aa6220bda2dbcb983d03af5a9f3b48ca89a6acc09a5f8f523b21983f7bcb33d3c5fc8e129')

build() {
  R CMD INSTALL ${_pkgname}_${_pkgver}.tar.gz -l "${srcdir}"
}

package() {
  install -dm0755 "${pkgdir}/usr/lib/R/library"
  cp -a --no-preserve=ownership "${_pkgname}" "${pkgdir}/usr/lib/R/library"
  install -Dm644 "${_pkgname}/LICENSE" -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
