_pkgname=dartR.base
_pkgver=1.3.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//[:-]/.}
pkgrel=1
pkgdesc="Analysing 'SNP' and 'Silicodart' Data - Basic Functions"
