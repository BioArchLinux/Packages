# Maintainer: Boris Shor <boris@bshor.com>

_pkgname=ragnar
_pkgver=0.3.1
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Retrieval-Augmented Generation (RAG) Workflows"
arch=(x86_64)
url="https://ragnar.tidyverse.org/"
license=('MIT')
depends=(
  r-blob
  r-cli
  r-commonmark
  r-curl
  r-dbi
  r-dbplyr
  r-dplyr
  r-duckdb
  r-glue
  r-httr2
  r-jsonlite
  r-mirai
  r-reticulate
  r-rlang
  r-rvest
  r-s7
  r-stringi
  r-tidyr
  r-vctrs
  r-withr
  r-xml2
)
optdepends=(
  r-connectcreds
  r-ellmer
  r-gargle
  r-jose
  r-knitr
  r-lifecycle
  r-mcptools
  r-nanoarrow
  r-openssl
  r-pandoc
  r-paws.common
  r-rmarkdown
  r-shiny
  r-stringr
  r-testthat
  r-tibble
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('77130bf6d7a4fa12729edaa4ce17204e')
b2sums=('41e294ade462be491eb6afd5a0bf31705a2cd6f8149079602920762727d573b2109f9ea8dcdf8a7e28a798655cb3d942c8563381e52758d7e8632a4cee82fcf4')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"

  install -d "$pkgdir/usr/share/licenses/$pkgname"
  ln -s "/usr/lib/R/library/$_pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname"
}
