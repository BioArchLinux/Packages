# Contributor: Shun Wang <shuonwang at gmail dot com>

_pkgname=highs
_pkgver=1.14.0-2
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=2
pkgdesc="'HiGHS' Optimization Solver"
arch=('x86_64')
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-or-later')
depends=(
  highs
  r-checkmate
  r-rcpp
)
makedepends=('cmake')
optdepends=(
  r-tinytest
  r-knitr
  r-rmarkdown
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('30520bb0378ccf4f2491603f7044abba')
b2sums=('9c6dad22dafa4ee08fbd9fcc075f2b643bcd98304eeb9899d9adab068cc802ba2cdd2d3a23f6682a6d16e2eac4082675238fa6843d42cbe18638401592cf307d')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
