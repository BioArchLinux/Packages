# Contributor: Shun Wang <shuonwang at gmail dot com>

_pkgname=highs
_pkgver=1.15.1-1
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="'HiGHS' Optimization Solver"
arch=('x86_64')
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-or-later')
depends=(
  highs
  r-checkmate
  r-rcpp
)
makedepends=('cmake')
optdepends=(
  r-tinytest
  r-knitr
  r-rmarkdown
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('28c73aa05551629a6d2aecb455affb7e')
b2sums=('d8ddd60fdc3f58da4e66d42a4b2c5b6813756fa662fc669e4533694100580501c27b26a3c1c15d1d48f71e46aaa6ff4d027989f34e2215ebc95357b338bf13ed')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
