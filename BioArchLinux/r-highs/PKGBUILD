_pkgname=highs
_pkgver=1.15.1-2
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="'HiGHS' Optimization Solver"
arch=('x86_64')
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-or-later')
depends=(
  highs
  r-checkmate
  r-rcpp
)
makedepends=('cmake')
optdepends=(
  r-tinytest
  r-knitr
  r-rmarkdown
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('6173fcb75f66be106245e7ac9b58149b')
b2sums=('1bfca6a701a66e83d3a61d905b9ec88ec7d8da1c2acc0e69367e92c585f0260fa7d6eaba7770f1c2fadf28833d11896322b12708967b7cfe640db01680377f57')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
