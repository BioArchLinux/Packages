# Maintainer: Boris Shor <boris@bshor.com>

_pkgname=usmapdata
_pkgver=1.1.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Mapping Data for 'usmap' Package"
arch=(any)
url="https://usmap.dev"
license=('GPL-3.0-or-later')
depends=(
  r-rlang
  r-sf
)
optdepends=(
  r-covr
  r-dplyr
  r-spelling
  r-testthat
  r-withr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('7e086d87f7f7306439c154821a915549')
b2sums=('a9f5c77830c72c9df0a565aaa2aa584c3957efc7120163ffbe9b1e7d4996309b7ebf33d9f078dbd559f1d39f3aadd07ceecb0f913c13afed66d0d20d914a0640')

build() {
  R CMD INSTALL ${_pkgname}_${_pkgver}.tar.gz -l "${srcdir}"
}

package() {
  install -dm0755 "${pkgdir}/usr/lib/R/library"
  cp -a --no-preserve=ownership "${_pkgname}" "${pkgdir}/usr/lib/R/library"
}
