_pkgname=pkgcache
_commit=68d8a1b993aaaf46e7b33dc82a3dff7b9245692b
pkgname=r-${_pkgname,,}
pkgver=2.2.5.9000
pkgrel=1
pkgdesc="Cache 'CRAN'-Like Metadata and R Packages"
arch=(x86_64)
url="https://github.com/r-lib/pkgcache"
license=('MIT')
depends=(
  r-callr
  r-cli
  r-curl
  r-filelock
  r-jsonlite
  r-processx
  r-r6
  r-tsitter
  r-tstoml
)
checkdepends=(
  r-mockery
  r-spelling
  r-testthat
  r-webfakes
)
optdepends=(
  r-debugme
  r-desc
  r-fs
  r-keyring
  r-pillar
  r-pingr
  r-rprojroot
  r-sessioninfo
  r-spelling
  r-testthat
  r-webfakes
  r-withr
  r-zip
)
source=("${_pkgname}-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz")
sha256sums=('7b96f587e8424c3699cba8cea5c8e02c1a4476317f6da33d443dcb296a6faca8')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname-$_commit"
}

#check() {
#  cd "$_pkgname-$_commit/tests"
#  R_LIBS="$srcdir/build" NOT_CRAN=true Rscript --vanilla testthat.R
#}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"

  install -d "$pkgdir/usr/share/licenses/$pkgname"
  ln -s "/usr/lib/R/library/$_pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname"
}
