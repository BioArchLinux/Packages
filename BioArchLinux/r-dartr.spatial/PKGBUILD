# Maintainer: Guoyi <kuoi@bioarchlinux.org>

_pkgname=dartR.spatial
_pkgver=1.3.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//[:-]/.}
pkgrel=1
pkgdesc="Applying Landscape Genomic Methods on 'SNP' and 'Silicodart' Data"
arch=('any')
url="https://cran.r-project.org/package=${_pkgname}"
license=('GPL-3.0-or-later')
depends=(
  r-adegenet
  r-crayon
  r-dartr.base
  r-dartr.data
  r-data.table
  r-ggplot2
  r-igraph
  r-raster
  r-sp
  r-stampp
  r-tidyr
  r-vegan
)
optdepends=(
  r-gdistance
  r-gplots
  r-mmod
  r-popgenreport
  r-rrblup
  r-sf
  r-terra
  r-testthat
  r-withr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('7689da12bf6f6ffcfc919e85382ff572')
b2sums=('40c999d7cce8916dd7880e585b46dcddedcd3777b747d4719961429bb5434b247c1fb7e8819a20219efc891fa21bc54d3633d952b719d8f9b3cc8240fa1fcc1b')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
