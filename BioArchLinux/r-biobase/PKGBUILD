_pkgname=Biobase
_pkgver=2.74.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Base functions for Bioconductor"
arch=(x86_64)
url="https://bioconductor.org/packages/$_pkgname"
license=('Artistic-2.0')
depends=(
  r-biocgenerics
)
optdepends=(
  r-all
  r-biocstyle
  r-golubesets
  r-knitr
  r-limma
  r-runit
  r-tkwidgets
)
source=("https://bioconductor.org/packages/release/bioc/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('6d08ba7113681e458f1a9bd2ab3b30dd')
b2sums=('09f07c3d95287fef20d2f8d59d420a6a751fd5786e0960fe6f8998545611e4ccc2117e4272fe12873198c748a5043cbf3a0478ddbb455cab9ba03aa8d290f0cb')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
