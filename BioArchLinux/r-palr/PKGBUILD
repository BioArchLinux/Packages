# Maintainer: Pekka Ristola <pekkarr [at] protonmail [dot] com>

_pkgname=palr
_pkgver=0.5.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Colour Palettes for Data"
arch=(any)
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-3.0-only')
depends=(
  r
)
checkdepends=(
  r-raster
  r-stars
  r-testthat
)
optdepends=(
  r-covr
  r-knitr
  r-raster
  r-rmarkdown
  r-stars
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('4c132352875c7bc28f44dba1e03ba418')
b2sums=('ec3678a02ec8c6946cf959dfbf96464f8c131c019f84077ffbb79b13eef826375802a95ea7952517330e9e401fcf3af967951dbaa49949c00cca918e07ef3f33')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

check() {
  cd "$_pkgname/tests"
  R_LIBS="$srcdir/build" NOT_CRAN=true Rscript --vanilla testthat.R
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
