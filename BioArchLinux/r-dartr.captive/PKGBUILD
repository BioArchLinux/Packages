_pkgname=dartR.captive
_pkgver=1.0.2
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//[:-]/.}
pkgrel=2
pkgdesc="Analysing 'SNP' Data to Support Captive Breeding"
arch=('any')
url="https://cran.r-project.org/package=${_pkgname}"
license=('GPL-3.0-or-later')
depends=(
  r-adegenet
  r-crayon
  r-dartr.base
  r-dartr.data
  r-dartr.sim
  r-data.table
  r-ggplot2
  r-gridextra
  r-magrittr
  r-patchwork
  r-processx
  r-reshape2
  r-stringr
  r-tidyr
)
optdepends=(
  r-dartr.popgen
  r-fields
  r-gplots
  r-igraph
  r-kinship2
  r-poibin
  r-rrblup
  r-scales
  r-siber
  r-spelling
  r-testthat
  r-tidyverse
  r-withr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('203cd884f02aa3e82b55abc5e7340f74')
b2sums=('33f309e040b5b4af852aa10d8a0354f1a53608569378766fac075f9495ea51d1be0f153a01b3778541a942d856b6a0c7358e2e151b0205c159d75b90b0fa371e')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
