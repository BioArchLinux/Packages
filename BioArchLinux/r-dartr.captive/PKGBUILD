_pkgname=dartR.captive
_pkgver=1.3.1
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//[:-]/.}
pkgrel=1
pkgdesc="Analysing 'SNP' Data to Support Captive Breeding"
arch=('any')
url="https://cran.r-project.org/package=${_pkgname}"
license=('GPL-3.0-or-later')
depends=(
  r-adegenet
  r-crayon
  r-dartr.base
  r-dartr.data
  r-dartr.sim
  r-data.table
  r-ggplot2
  r-gridextra
  r-magrittr
  r-patchwork
  r-processx
  r-reshape2
  r-stringr
  r-tidyr
)
optdepends=(
  r-dartr.popgen
  r-fields
  r-gplots
  r-igraph
  r-kinship2
  r-poibin
  r-rrblup
  r-scales
  r-siber
  r-spelling
  r-testthat
  r-tidyverse
  r-withr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('f187d5fe37e6c7768d52e1552e252780')
b2sums=('121c951c11bdc825bd33e58c3d93d603490beff3f82f8bceadf2913cabca30b7ffa56a8b60e87269a60124c04d1f1f11c65c451a4796e0a62aafafc5b520b5dc')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
