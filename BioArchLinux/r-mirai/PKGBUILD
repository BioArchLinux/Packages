# Maintainer: Shun Wang <shuonwang at gmail dot com>

_pkgname=mirai
_pkgver=2.7.3
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Minimalist Async Evaluation Framework for R"
arch=('any')
url="https://cran.r-project.org/package=$_pkgname"
license=('MIT')
depends=(
  r-nanonext
)
optdepends=(
  r-cli
  r-litedown
  r-mori
  r-otel
  r-otelsdk
  r-secretbase
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('84bfa1981bf129efeecfd973c264e146')
b2sums=('b6d0f25424012e95eef92fe39b6017ba71e8548028e6de44fbb3f8252cde7603ec8ad84cda29362fe962ac6cfb3962d4f57690d30d8ca4bce1b74a019465d5eb')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
