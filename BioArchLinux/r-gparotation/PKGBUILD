_pkgname=GPArotation
_pkgver=2026.8-1
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Gradient Projection Factor Rotation"
arch=(any)
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-or-later')
depends=(
  r
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('666ec1680be4812ef1245c62556e141f')
b2sums=('8af502ab68d61a24e79069c0d638f0a8974355c2374106d71897864a64303f7d5b56329f18ef5b5aeabe6959ddb97c868c1fba9931f10470caadb13cea935275')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
