_pkgname=Formula
_pkgver=1.2-6
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Extended Model Formulas"
arch=(any)
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-only OR GPL-3.0-only')
depends=(
  r
)
optdepends=(
  r-knitr
  r-rmarkdown
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('230a93c95eaabdfc7a2e958efbbe25db')
b2sums=('372ebeadcfe341b2c1a87696bd06f8e13af45136d971c76f1fcf66d5ce6cbda724e1947ae86ec5384c4e517448759568a43d9301aa3d3d13ae68aff9a780ef08')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
