_pkgname=SimDesign
_pkgver=2.27
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Structure for Organizing Monte Carlo Simulation Designs"
arch=('any')
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-or-later')
depends=(
  r-beepr
  r-clipr
  r-dplyr
  r-e1071
  r-future
  r-future.apply
  r-parallelly
  r-pbapply
  r-progressr
  r-qs2
  r-r.utils
  r-sessioninfo
  r-testthat
)
optdepends=(
  r-cli
  r-copula
  r-extradistr
  r-frf2
  r-future.batchtools
  r-ggplot2
  r-httr
  r-job
  r-knitr
  r-mirai
  r-purrr
  r-renv
  r-rmarkdown
  r-rpushbullet
  r-shiny
  r-tidyr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('4500b72ab3857ad9238352fc61217c20')
b2sums=('0f9a53ffc52df968ae31e0ca64f5c240a456a2e4f09111c799fcbd456d69915b0db3f3a3138fbd8113d4eb984091bd62ee66456c3ddb5f08d8eca733d2b555b0')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
