_pkgname=SimDesign
_pkgver=2.26
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Structure for Organizing Monte Carlo Simulation Designs"
arch=('any')
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-or-later')
depends=(
  r-beepr
  r-clipr
  r-dplyr
  r-e1071
  r-future
  r-future.apply
  r-parallelly
  r-pbapply
  r-progressr
  r-qs2
  r-r.utils
  r-sessioninfo
  r-testthat
)
optdepends=(
  r-cli
  r-copula
  r-extradistr
  r-frf2
  r-future.batchtools
  r-ggplot2
  r-httr
  r-job
  r-knitr
  r-mirai
  r-purrr
  r-renv
  r-rmarkdown
  r-rpushbullet
  r-shiny
  r-snow
  r-tidyr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('c25a2513e24348bb718d9959b49daa67')
b2sums=('62533c6699eda6d208d7167dae5e8413c1b6646a32e0b42c9253b01e408862a8ae9f17eb1df43cc986cb8d216deec1c81aa717cd4b25d66f8248ef6a102f65a4')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
