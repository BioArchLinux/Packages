_pkgname=SimDesign
_pkgver=2.28
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Structure for Organizing Monte Carlo Simulation Designs"
arch=('any')
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-or-later')
depends=(
  r-beepr
  r-clipr
  r-dplyr
  r-e1071
  r-future
  r-future.apply
  r-parallelly
  r-pbapply
  r-progressr
  r-qs2
  r-r.utils
  r-sessioninfo
  r-testthat
)
optdepends=(
  r-cli
  r-copula
  r-extradistr
  r-frf2
  r-future.batchtools
  r-ggplot2
  r-httr
  r-job
  r-knitr
  r-mirai
  r-purrr
  r-renv
  r-rmarkdown
  r-rpushbullet
  r-shiny
  r-tidyr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('687d695778c79ead6a9563a296f4aba4')
b2sums=('b2ac7c8174db76937992debb34186e5ed69d283a7e0db9bae3fd54137934cb042372d7748c689be75dbc51a182b6e9539953eac437c46423c3331a10454a0317')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
