_pkgname=lambda.r
_pkgver=1.2.6
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Modeling Data with Functional Programming"
arch=(any)
url="https://cran.r-project.org/package=$_pkgname"
license=('LGPL-3.0-only')
depends=(
  r-formatr
)
optdepends=(
  r-testit
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('cfd18ed648c858a7873506af81469de2')
b2sums=('a3e1e850088f1a43b7a75f12796186a7cab4217fd783680a5df1ba1926281efe63b1771adade003210d2d00c16eb74b2f6cdf991e6aa44759542983fbcf1817c')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
