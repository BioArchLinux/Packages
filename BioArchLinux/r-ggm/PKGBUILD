_pkgname=ggm
_pkgver=2.5.4
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Graphical Markov Models with Mixed Graphs"
arch=(any)
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-only')
depends=(
  r-biocmanager
  r-graph
  r-igraph
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('a3c7a9ceb913007b0dd6db07315e0042')
b2sums=('8a8c957b0bdcb5a5c6857ff6307aeef2e560228861fe1e7bf2dff13b1f28ab435955786026fd6c2629616c84c585b6df10ac16c444dd730b2bd315ad33f4bfe8')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
