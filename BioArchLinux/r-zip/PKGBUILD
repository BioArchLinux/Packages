_pkgname=zip
_pkgver=3.0.2
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Cross-Platform 'zip' Compression"
arch=(x86_64)
url="https://cran.r-project.org/package=$_pkgname"
license=('MIT')
depends=(
  r
)
makedepends=(
  r-cli
)
checkdepends=(
  7zip
  r-curl
  r-testthat
  r-webfakes
)
optdepends=(
  r-callr
  r-cli
  r-curl
  r-pillar
  r-processx
  r-r6
  r-testthat
  r-webfakes
  r-withr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('95c0f66d6240403c2e1059068e617124')
b2sums=('038893842661c3df7dfa488533c5f395bfc6379dfe8c473396c1082934c1709bf1de88b08bf09ea8f29adf78f883944f12d8ffc7d385712db2d023218e0d99b6')

build() {
  mkdir -p build
  R CMD INSTALL -l build "$_pkgname"
}

check() {
  cd "$_pkgname/tests"
  R_LIBS="$srcdir/build" NOT_CRAN=true Rscript --vanilla testthat.R
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"

  install -d "$pkgdir/usr/share/licenses/$pkgname"
  ln -s "/usr/lib/R/library/$_pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname"
}
