# Maintainer: Guoyi <kuoi@malacology.net>

_pkgname=geomorph
_pkgver=4.1.2
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc='Geometric Morphometric Analyses of 2D and 3D Landmark Data'
arch=('any')
url="https://cran.r-project.org/package=${_pkgname}"
license=('GPL-3.0-or-later')
depends=(
  r-ape
  r-ggplot2
  r-jpeg
  r-plotly
  r-rrpp
)
optdepends=(
  r-dplyr
  r-knitr
  r-rmarkdown
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('db7d70cb9e511272004806a8391830bd')
b2sums=('70b9eb16a4285dc6724d7d37b4a0752fd30d93278fdb807f426fa45ebfe008a5d01e0c5b6a75f88db0d6a4cd473ba97b7a1b65f950e89e2ddff163950016d660')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
