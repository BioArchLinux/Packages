_pkgname=git2r
_pkgver=0.36.2
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Provides Access to Git Repositories"
arch=(x86_64)
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-only')
depends=(
  libgit2
  r
)
optdepends=(
  r-getpass
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('e1a6d25fe9fd26f781d2643b79ed594a')
b2sums=('3cfcbd1031065ae831463da540efa9b9f9302a8741f5c91ecea10b099bee5d87656a82bcaefd3817b0ebb93cdbb6b5411af971f33bc66ce963151b32ab496f78')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
