_pkgname=extrafontdb
_pkgver=1.1
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Holding the Database for the 'extrafont' Package"
arch=(any)
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-2.0-only')
depends=(
  r
)
optdepends=(
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('2eedb44e42dd01f7f26d7c318d0574bc')
b2sums=('6b9990bf59ba3c0c7ce66f4a8430d097a0a6656c5cd7d7b3d18949e1c3ac1fa1871e10c84dea25cd7741d1cfab16634125263e31090170bb1a9020acd1a753ca')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
