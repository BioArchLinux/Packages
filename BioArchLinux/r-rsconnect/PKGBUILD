_pkgname=rsconnect
_pkgver=1.11.1
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Deploy Docs, Apps, and APIs to 'Posit Connect', 'shinyapps.io', and 'RPubs'"
arch=(any)
url="https://cran.r-project.org/package=${_pkgname}"
license=('GPL-2.0-only')
depends=(
  r-cli
  r-curl
  r-digest
  r-httr2
  r-jsonlite
  r-lifecycle
  r-openssl
  r-packrat
  r-renv
  r-rlang
  r-rstudioapi
  r-snowflakeauth
  r-yaml
)
optdepends=(
  r-biobase
  r-biocmanager
  r-knitr
  r-plumber
  r-quarto
  r-reticulate
  r-rmarkdown
  r-shiny
  r-testthat
  r-webfakes
  r-withr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('366147ec4e601c432c9fb11d3262d7a4')
b2sums=('8cd8921960c17ef51de762056802731616d578e4bd5f543aa12593611c77ddd7ab2bf1b8fa22fb683065c8f2e2255389c4796c7c5b2c5ce88baed6b3d4f7ba3c')

build() {
  R CMD INSTALL ${_pkgname}_${_pkgver}.tar.gz -l "${srcdir}"
}

package() {
  install -dm0755 "${pkgdir}/usr/lib/R/library"
  cp -a --no-preserve=ownership "${_pkgname}" "${pkgdir}/usr/lib/R/library"
}
