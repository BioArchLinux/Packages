_pkgname=Deriv
_pkgver=4.3.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Symbolic Differentiation"
arch=('x86_64')
url="https://cran.r-project.org/package=$_pkgname"
license=('GPL-3.0-or-later')
depends=(
  r-rcpp
)
optdepends=(
  r-testthat
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('379732250a50bde145f56415bda818f6')
b2sums=('91863f1f9f4d85fd5a0ef0337747543599231ac115e20c46c84df2ddc93e4d375e517a33afdf8b4add53f2e6b3ae0be2c502ca99850689d1b92d73ed9d1e8253')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
