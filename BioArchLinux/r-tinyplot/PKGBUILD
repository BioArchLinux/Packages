# Maintainer: Shun Wang <shuonwang [at] gmail [dot] com>

_pkgname=tinyplot
_pkgver=0.8.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//-/.}
pkgrel=1
pkgdesc="Lightweight Extension of the Base R Graphics System"
arch=(any)
url="https://cran.r-project.org/package=$_pkgname"
license=('Apache')
depends=(
  r
)
optdepends=(
  r-fontquiver
  r-png
  r-rsvg
  r-svglite
  r-tinytest
  r-tinysnapshot
  r-knitr
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('5df6658d81fbeb18a93b298f45ee9491')
b2sums=('f196f4a5276be886d655123801243f5732db3da4dfe4fcdc236cafa55e388271205862120360b6492e4c3ff1da74481d8d7795ca8580ab865b55c1212c97075d')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
